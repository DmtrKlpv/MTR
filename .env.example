# Скопируйте в .env и заполните.

# Путь к музыкальной библиотеке на ХОСТЕ.
# Windows:   MUSIC_PATH=M:/Music/All/Classics
# Linux/mac: MUSIC_PATH=/srv/music
MUSIC_PATH=/srv/music

# Ключ шифрования паролей. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ВНИМАНИЕ: при смене ключа сохранённые пароли станут нечитаемыми,
# и Subsonic-авторизация перестанет работать. Сделайте бэкап.
MTR_SECRET_KEY=

MTR_ADMIN_USER=admin
MTR_ADMIN_PASSWORD=changeme123

# --- Наблюдение за библиотекой ---
# Windows/Docker Desktop (MUSIC_PATH=D:/...): inotify не работает, нужен опрос.
# Linux/macOS с нативным томом: MTR_WATCH_POLL=0.
MTR_WATCH=1
MTR_WATCH_POLL=1
MTR_WATCH_POLL_MS=1000
# Страховочный инкрементальный скан, секунд. 0 — выключен.
MTR_SCAN_INTERVAL=300


#создать админа
#docker exec -it mtr-server python -m app.cli createuser --username admin --password "ВашПароль123" --role admin --display-name "Administrator"

#Если пользователь уже существует, createuser упадёт с ошибкой уникальности. Тогда сменить пароль:
#docker exec -it mtr-server python -m app.cli setpassword --username admin --password "НовыйПароль123"