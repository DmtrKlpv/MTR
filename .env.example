# Пути на NAS
MUSIC_PATH=/share/CACHEDEV1_DATA/Multimedia/Music
DATA_PATH=/share/CACHEDEV1_DATA/Container/mtr-data

# Порт на хосте (контейнер всегда слушает 4533)
MTR_PORT=4533

# Ключ шифрования паролей. Сгенерировать на ПК:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Меняйте только осознанно: сохранённые пароли станут нечитаемыми.
MTR_SECRET_KEY=

# Стартовый администратор. Создаётся только на пустой базе.
MTR_ADMIN_USER=admin
MTR_ADMIN_PASSWORD=

MTR_LOG_LEVEL=INFO


# Наблюдение за библиотекой
# Windows/Docker Desktop (MUSIC_PATH=D:/...): inotify не работает, нужен опрос.
# Linux/macOS с нативным томом: MTR_WATCH_POLL=0.
MTR_WATCH=0
MTR_WATCH_POLL=0
MTR_WATCH_POLL_MS=2000

# Страховочный инкрементальный скан, секунд. 0 — выключен.
MTR_SCAN_INTERVAL=0


# для старых процов arm
# docker buildx build --no-cache --platform linux/arm/v7 -t mtr-app:0135 --load .
# docker save mtr-app:0135 -o yourway/mtr-app-0135.tar

# проверка
# docker exec -it mtr-app python -m app.cli doctor

# Если не создался админ:
# docker exec -it mtr-app python -m app.cli createuser --username admin --password "ВашПароль123" --role admin --display-name "Administrator"

# статистика библиотеки
# docker exec -it mtr-app python -m app.cli stats

# проверка образа
# docker image inspect mtr-app:0135 --format "{{.Architecture}}/{{.Variant}}"

# для старых QNAP
#Container Station при создании контейнера через интерфейс сам подставляет тома с хешами, даже если в файле указаны пути.
#Если контейнер запущен не через docker compose up из папки mtr, .env не читается, и пути не применяются. Чтобы такого не повторилось,
#запускайте только командой docker compose up -d из папки c музыкой (например /share/CACHEDEV1_DATA/Container/mtr), а контейнеры
#в Container Station не создавайте.