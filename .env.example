# Пути на NAS
MUSIC_PATH=/share/CACHEDEV1_DATA/Multimedia/Music
DATA_PATH=/share/CACHEDEV1_DATA/Container/mtr-data

# Порт на хосте (контейнер всегда слушает 4533)
MTR_PORT=4533

# Ключ шифрования паролей. Сгенерировать на ПК:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Меняйте только осознанно: сохранённые пароли станут нечитаемыми.
MTR_SECRET_KEY=

# Стартовый администратор. Создаётся только на пустой базе.
MTR_ADMIN_USER=admin
MTR_ADMIN_PASSWORD=

MTR_LOG_LEVEL=INFO

# Наблюдение за библиотекой
# Windows/Docker Desktop (MUSIC_PATH=D:/...): inotify не работает, нужен опрос.
# Linux/macOS с нативным томом: MTR_WATCH_POLL=0.
MTR_WATCH=1
MTR_WATCH_POLL=0
MTR_WATCH_POLL_MS=2000

# Страховочный инкрементальный скан, секунд. 0 — выключен.
MTR_SCAN_INTERVAL=1800