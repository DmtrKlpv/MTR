# Ключ шифрования паролей. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ВНИМАНИЕ: при смене ключа сохранённые пароли станут нечитаемыми,
# и Subsonic-авторизация перестанет работать. Сделайте бэкап.
MTR_SECRET_KEY=my_super_secret_key_123

MTR_ADMIN_USER=admin
MTR_ADMIN_PASSWORD=changeme123

###############################

# Путь к музыкальной библиотеке на ХОСТЕ.
# Windows:   MUSIC_PATH=M:/Music/All/Classics
# Linux/mac: MUSIC_PATH=/srv/music
MUSIC_PATH=D:/music_temp

###############################

# Наблюдение за библиотекой
# Windows/Docker Desktop (MUSIC_PATH=С:/...): inotify не работает, нужен опрос MTR_WATCH_POLL=1.
# Linux/macOS с нативным томом: MTR_WATCH_POLL=0.
MTR_WATCH=1
MTR_WATCH_POLL=1
MTR_WATCH_POLL_MS=1000

# Страховочный инкрементальный скан, секунд. 0 — выключен.
MTR_SCAN_INTERVAL=300

###############################

MTR_COOKIE_SECURE=1

# дефолтные данные

